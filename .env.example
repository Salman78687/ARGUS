# Copy to .env and fill in real values. .env is gitignored — never commit it.
#   cp .env.example .env

# ── Branding ──
ASSISTANT_NAME=ARGUS
PRODUCT_NAME=<your-product-name>
ESCALATION_CONTACT=<your-support-team-or-email>
# Optional: path to a custom system-prompt template (supports {assistant_name},
# {product_name} and {escalation_contact} placeholders)
# SYSTEM_PROMPT_FILE=prompts/system_prompt.txt

# ── LLM server (any OpenAI-compatible API: vLLM, Ollama, LM Studio, OpenAI, …) ──
# Either set LLM_BASE_URL directly, or LLM_SERVER_IP + LLM_SERVER_PORT for http://IP:PORT/v1
# LLM_BASE_URL=http://localhost:11434/v1
LLM_SERVER_IP=127.0.0.1
LLM_SERVER_PORT=8000
LLM_API_KEY=<your-llm-api-key-or-EMPTY>
LLM_MODEL=meta-llama/Llama-4-Scout-17B-16E-Instruct
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7

# ── Knowledge base / RAG ──
KB_PDF_PATH=knowledge_base.pdf      # a PDF file or a folder of PDFs
KB_COLLECTION=argus_kb
CHROMA_DIR=chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=7
RAG_MIN_SIMILARITY=0.28

# ── PostgreSQL live context (optional — disabled if db_sources.json is absent) ──
DB_SOURCES_FILE=db_sources.json
DB_HOST=localhost
DB_PORT=5432
DB_NAME=argus
DB_USER=argus_readonly
DB_PASSWORD=<your-db-password>

# ── Server ──
APP_HOST=127.0.0.1
APP_PORT=5000
FLASK_DEBUG=false
LOG_FILE=argus.log
